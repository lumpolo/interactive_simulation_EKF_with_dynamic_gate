     "text": [
      "```python\n",
      "def _classify_and_update(self, measurements: list[dict], noisy_control: tuple[float, float]) -> None:\n",
      "    R = np.diag([self.cfg.sigma_range ** 2, self.cfg.sigma_bearing ** 2])\n",
      "    accepted_static = []\n",
      "    dynamic_world = []\n",
      "    predicted_pose = self.ekf.x.copy()\n",
      "    for measurement in measurements:\n",
      "        z = measurement['z']\n",
      "        observed_rel = measurement_to_relative(z)\n",
      "        candidates = []\n",
      "        for i, landmark in enumerate(self.landmarks):\n",
      "            expected_rel = relative_xy(predicted_pose, landmark)\n",
      "            rel_error = np.linalg.norm(observed_rel - expected_rel)\n",
      "            d2, S = self.ekf.innovation_distance(z, landmark, R)\n",
      "            gate = self._dynamic_motion_gate(S, z[0], abs(noisy_control[0]))\n",
      "            candidates.append((rel_error, d2, gate, i))\n",
      "        rel_error, d2, gate, best_idx = min(candidates, key=lambda item: item[0])\n",
      "        is_static_consistent = rel_error < self.cfg.association_gate and d2 < gate\n",
      "        if is_static_consistent:\n",
      "            self.ekf.update(z, self.landmarks[best_idx], R)\n",
      "            accepted_static.append(self.landmarks[best_idx])\n",
      "            self.accepted_count += 1\n",
      "        else:\n",
      "            dynamic_world.append(self._measurement_world_point(z))\n",
      "            self.rejected_count += 1\n",
      "            if measurement['source'] == 'person':\n",
      "                self.dynamic_count += 1\n",
      "    self.accepted_static_world = np.array(accepted_static) if accepted_static else np.empty((0, 2))\n",
      "    self.detected_dynamic = np.array(dynamic_world) if dynamic_world else np.empty((0, 2))\n",
      "    self.current_gate_static = len(accepted_static)\n",
      "    self.current_gate_dynamic = len(dynamic_world)\n",
      "```\n",
      "\n",
      "```python\n",
      "def _dynamic_motion_gate(self, S: np.ndarray, measured_range: float, speed: float) -> float:\n",
      "    uncertainty = np.sqrt(max(np.linalg.det(S), 0.0))\n",
      "    threshold = self.cfg.base_gate + self.cfg.gate_uncertainty_gain * uncertainty + self.cfg.gate_speed_gain * speed - self.cfg.gate_range_tightening * measured_range\n",
      "    return float(np.clip(threshold, self.cfg.min_gate, self.cfg.max_gate))\n",
      "```\n",
      "\n"
     ]
