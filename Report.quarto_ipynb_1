      "```python\n",
      "def step_unicycle(state: np.ndarray, control: tuple[float, float], dt: float) -> np.ndarray:\n",
      "    v, omega = control\n",
      "    x, y, th = state\n",
      "    return np.array([x + v * np.cos(th) * dt, y + v * np.sin(th) * dt, wrap_angle(th + omega * dt)])\n",
      "```\n",
      "\n",
      "```python\n",
      "def _move_people(self) -> None:\n",
      "    self.people += self.people_vel * self.cfg.dt\n",
      "    limit = 0.8 * self.cfg.world_size\n",
      "    for i in range(len(self.people)):\n",
      "        for axis in range(2):\n",
      "            if self.people[i, axis] < -limit or self.people[i, axis] > limit:\n",
      "                self.people_vel[i, axis] *= -1.0\n",
      "                self.people[i, axis] = np.clip(self.people[i, axis], -limit, limit)\n",
      "```\n",
      "\n"
     ]
