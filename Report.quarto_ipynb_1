     "text": [
      "```python\n",
      "def predict(self, control: tuple[float, float]) -> None:\n",
      "    v, omega = control\n",
      "    x, y, th = self.x\n",
      "    dt = self.cfg.dt\n",
      "    self.x = np.array([x + v * np.cos(th) * dt, y + v * np.sin(th) * dt, wrap_angle(th + omega * dt)])\n",
      "    F = np.array([[1.0, 0.0, -v * np.sin(th) * dt], [0.0, 1.0, v * np.cos(th) * dt], [0.0, 0.0, 1.0]])\n",
      "    Q = np.diag([self.cfg.process_sigma_xy ** 2, self.cfg.process_sigma_xy ** 2, self.cfg.process_sigma_theta ** 2])\n",
      "    self.P = F @ self.P @ F.T + Q\n",
      "```\n",
      "\n",
      "```python\n",
      "def innovation_distance(self, z: np.ndarray, landmark: np.ndarray, R: np.ndarray) -> tuple[float, np.ndarray]:\n",
      "    z_hat, H = self.measurement_model(landmark)\n",
      "    innovation = z - z_hat\n",
      "    innovation[1] = wrap_angle(innovation[1])\n",
      "    S = H @ self.P @ H.T + R\n",
      "    d2 = float(innovation.T @ np.linalg.inv(S) @ innovation)\n",
      "    return (d2, S)\n",
      "```\n",
      "\n",
      "```python\n",
